{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Facebook Video Loader",
  "version": "1.4.0",
  "description": "Find and download Facebook videos sequentially in the signed-in browser profile.",
  "permissions": ["downloads", "storage", "offscreen"],
  "host_permissions": [
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://fb.watch/*",
    "https://*.fb.watch/*",
    "https://fb.gg/*",
    "https://*.fb.gg/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://jiranot.github.io/*",
    "https://facedownload.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://jiranot.github.io/facedownload/*", "https://facedownload.vercel.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://facebook.com/*",
        "https://*.facebook.com/*",
        "https://fb.watch/*",
        "https://*.fb.watch/*",
        "https://fb.gg/*",
        "https://*.fb.gg/*"
      ],
      "js": ["video-parser.js", "facebook-page.js"],
      "run_at": "document_idle"
    }
  ]
}
